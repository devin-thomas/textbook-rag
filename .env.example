# Runtime paths are resolved relative to the repository unless absolute.
TEXTBOOK_DATABASE=data/textbook-desk.sqlite3
TEXTBOOK_CATALOG=config/sources.json
TEXTBOOK_INGESTION_REPORT=reports/generated/ingestion.json

# The app and Ollama tunnel stay loopback-only. Tailscale Serve is the ingress.
OLLAMA_BASE_URL=http://127.0.0.1:11435

# Retrieval and local models.
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
OLLAMA_GENERATION_MODEL=qwen3.5:9b
OLLAMA_EMBEDDING_DIMENSION=2560

# NVIDIA uses an OpenAI-compatible hosted endpoint. Put the actual key only in
# an ignored .env file or point at the existing ignored NVIDIA dotenv file.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_API_KEY=
# NVIDIA_DOTENV_PATH=C:\dev\experiments\free-nvidia-ai\nv.env

# Retrieval defaults. Tune only alongside the reproducible evaluation suite.
RETRIEVAL_SEMANTIC_CANDIDATES=24
RETRIEVAL_FTS_CANDIDATES=24
RETRIEVAL_FINAL_CHUNKS=8
RETRIEVAL_MIN_SEMANTIC_SCORE=0.18
MAX_QUESTION_CHARS=4000
